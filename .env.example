# Copia este archivo a ".env" y ajusta los valores. El archivo .env NO se versiona.
NODE_ENV=development
PORT=3000

# Clave para firmar los JWT (mínimo 16 caracteres). Genera una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambia-esto-por-una-clave-larga-y-secreta
JWT_EXPIRES_IN=12h

# Dominios desde los que se aceptan conexiones WebSocket (separados por coma).
# En desarrollo se agregan solas las IP de tu red local. Usa * para permitir todos (no recomendado).
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Base de datos SQLite (los mensajes se guardan aquí)
DB_PATH=./data/chat.db

# Archivos adjuntos (imágenes hasta 5 MB, audios hasta MAX_UPLOAD_MB)
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=10

MAX_MESSAGE_LENGTH=500
HISTORY_LIMIT=50
